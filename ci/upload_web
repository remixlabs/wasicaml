#!/usr/bin/env bash
set -euo pipefail && cd "$(dirname "${BASH_SOURCE[0]}")/.."

tar czf wasicaml-${BUILD_TAG}-$ARCH.tar.gz -C ~/ .wasicaml
assets=wasicaml-${BUILD_TAG}-$ARCH.tar.gz

for asset in $assets; do
    rcm gcs cp --disable-cache "$asset" gs://rmx-static/wasicaml/p-${BUILD_TAG}/"$asset"
done

echo "Upload successful"
